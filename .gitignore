# La configuración local de los agentes no se versiona; las skills del proyecto, sí (ADR-035).
.claude/*
!.claude/skills/

# Los planes de trabajo viven fuera de los repositorios (ADR-035): si alguien crea uno aquí por
# costumbre, no se sube.
/plan/

# Snapshots de la base de datos (se generan a demanda, no se versionan)
/snapshots/

# Supabase (CLI local)
supabase/.branches/
supabase/.temp/
install.cmd
.env
.env.*
!.env.example

# Con el acomodo del ADR-025 los repositorios de código vivían aquí adentro. Desde el ADR-035 son
# hermanos de este, y la regla se queda para que una copia vieja no se suba por error.
/repositories/
